# Copy to .env and fill in. .env is gitignored.
#
# Nobitex API key pair, created at POST /apikeys/create with TRADE permission.
# Both halves are 44-character base64 and look identical -- the PRIVATE key is
# the one shown only once, at creation. Requests are signed with it (Ed25519);
# neither half is a bearer token.
NOBITEX_API_KEY=
NOBITEX_API_SECRET=
